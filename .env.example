# Copy to .env and fill in. .env is gitignored — never commit a real token.

# System User access token with ads_read (ads_management only if you later
# add write features; the audit is read-only and does not need it).
META_ACCESS_TOKEN=

# Ad account id. With or without the act_ prefix; both are accepted.
META_AD_ACCOUNT_ID=act_000000000000

# Graph API version. Bump this when Meta deprecates the default below.
# If you get error code 2635 or "Unsupported get request", change this first.
META_API_VERSION=v23.0

# Optional: app secret enables appsecret_proof, which Meta requires when the
# app has "Require app secret" turned on for API calls.
META_APP_SECRET=
